{
  "name": "github-watcher",
  "version": "1.0.0",
  "description": "GitHub followers and following watcher",
  "type": "module",
  "scripts": {
    "dev": "node --import @swc-node/register/esm-register src/main.ts",
    "build": "tsc",
    "test": "vitest --run",
    "coverage": "vitest run --coverage",
    "list-followers": "node --import @swc-node/register/esm-register src/main.ts list-followers",
    "list-following": "node --import @swc-node/register/esm-register src/main.ts list-following"
  },
  "keywords": [],
  "author": "Kai",
  "license": "MIT",
  "dependencies": {
    "@effect/cli": "^0.77.2",
    "@effect/platform-node": "^0.108.4",
    "@octokit/rest": "^22.0.1",
    "@swc-node/register": "^1.12.1",
    "dotenv": "^16.6.1",
    "effect": "^3.22.4"
  },
  "devDependencies": {
    "@effect/vitest": "^0.30.1",
    "@types/node": "^20.19.43",
    "@vitest/coverage-v8": "^4.1.12",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  },
  "pnpm": {
    "overrides": {
      "toml": "^5.0.1"
    }
  }
}
